# =============================================================================
# Configuration du Cloud Temple Calculator — copier en .env et adapter
# =============================================================================
# Docker Compose lit .env automatiquement. Le .env réel ne se commite JAMAIS
# (il porte le mot de passe de la base et le barème interne).

# --- Exposition (WAF) ---
# Port publié sur l'hôte. Seul le WAF est exposé.
WAF_PORT=8088
# Adresse servie par Caddy :
#   :8082                        → HTTP (local, ou derrière un reverse proxy TLS amont)
#   calculator.cloud-temple.app  → HTTPS Let's Encrypt automatique ; publier alors
#                                   les ports 80 et 443 du service waf (cf. README).
SITE_ADDRESS=:8082
# Derrière un reverse proxy amont SEULEMENT : son adresse ou son réseau (CIDR,
# plusieurs valeurs séparées par des espaces). Sans cela, toutes les requêtes
# semblent venir du proxy et le rate limiting par IP devient commun à tous.
# Défaut : personne de confiance (TLS direct ou local). Ne jamais mettre un
# réseau d'où des clients peuvent se connecter directement.
TRUSTED_PROXIES=127.0.0.1/32

# --- Base PostgreSQL ---
# Obligatoire. Valeur longue et aléatoire, par exemple : openssl rand -hex 32
CALCULATOR_POSTGRES_PASSWORD=change-me
# CALCULATOR_POSTGRES_USER=calculator
# CALCULATOR_POSTGRES_DB=calculator

# --- Tarification ---
# Mode partenaire (remise catalogue). « no » sur tout déploiement public.
CALCULATOR_VIEW_PARTNER=no
# Barème engagement → remise, format « mois:pct,mois:pct ». Donnée métier
# INTERNE : la valeur réelle n'est jamais écrite dans ce dépôt. Sans effet
# hors mode partenaire ; laisser vide sur un déploiement public.
CALCULATOR_ENGAGEMENT_DISCOUNT_SCALE=

# --- Synchronisation du catalogue ---
# Intervalle de synchro automatique en secondes (0 = désactivée).
CALCULATOR_SYNC_POLL_INTERVAL_SECONDS=900
